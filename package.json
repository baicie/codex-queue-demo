{
  "name": "codex-queue-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-queue": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node dist/src/cli.js run --queue demo/queue.json --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
