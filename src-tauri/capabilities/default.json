{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Codex Queue window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-load-queue",
    "allow-save-queue",
    "allow-run-queue",
    "allow-list-task-runs",
    "allow-read-task-run"
  ]
}
